{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/SubjectProfileCandidateV01.schema.json","title":"SubjectProfileCandidateV01","description":"Non-authoritative subject understanding with observable facts separated from photography inferences.","type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","disposition","observed","photography_inferences","confidence"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"candidate_id":{"type":"string","minLength":1,"maxLength":160},"disposition":{"const":"CANDIDATE"},"confidence":{"type":"number","minimum":0,"maximum":1},
    "observed":{"type":"object","additionalProperties":false,"required":["observation_ids","clothing_categories","dominant_colors","secondary_colors","color_relationship","visible_accessories","visible_styling","silhouette_observations","pose_feasibility_observations","evidence_refs"],"properties":{
      "observation_ids":{"$ref":"#/$defs/nonEmptyStrings"},"clothing_categories":{"$ref":"#/$defs/nonEmptyStrings"},"dominant_colors":{"$ref":"#/$defs/nonEmptyStrings"},"secondary_colors":{"$ref":"#/$defs/strings"},"color_relationship":{"type":"string","minLength":1,"maxLength":200},"visible_accessories":{"$ref":"#/$defs/strings"},"visible_styling":{"$ref":"#/$defs/strings"},"silhouette_observations":{"$ref":"#/$defs/strings"},"pose_feasibility_observations":{"$ref":"#/$defs/strings"},"evidence_refs":{"$ref":"#/$defs/nonEmptyStrings"}
    }},
    "photography_inferences":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/inference"}}
  },
  "$defs":{"strings":{"type":"array","items":{"type":"string","minLength":1}},"nonEmptyStrings":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"inference":{"type":"object","additionalProperties":false,"required":["inference_id","claim","based_on_observation_ids","confidence"],"properties":{"inference_id":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1,"maxLength":320},"based_on_observation_ids":{"$ref":"#/$defs/nonEmptyStrings"},"confidence":{"type":"number","minimum":0,"maximum":1}}}}
}
