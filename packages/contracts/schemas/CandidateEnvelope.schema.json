{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/CandidateEnvelope.schema.json","title":"CandidateEnvelope","description":"Default envelope for unaccepted AI output. CANDIDATE is not workflow truth until a named gate promotes it.","type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","candidate_kind","created_at","producer","payload","disposition"],
