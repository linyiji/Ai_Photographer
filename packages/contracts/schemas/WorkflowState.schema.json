  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/WorkflowState.schema.json","title":"WorkflowState","description":"Persistent logical workflow position shared by all runtimes.","type":"object","additionalProperties":false,
