{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/LiveShotRuntime.schema.json","title":"LiveShotRuntime","description":"Client/mobile ephemeral authority for per-frame control; not persisted frame-by-frame and distinct from PhotographySession.","type":"object","additionalProperties":false,
