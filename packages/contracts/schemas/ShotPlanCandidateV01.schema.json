{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xfx.local/contracts/v1/ShotPlanCandidateV01.schema.json",
  "title": "ShotPlanCandidateV01",
  "description": "Non-authoritative Photography Director proposal grounded in accepted evidence and projected to a LiveTargetBlueprintV01.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "disposition", "selection_status", "photo_concept", "view_ref", "framing", "required_body_parts", "image_plane_placement", "pose_plan", "camera_direction", "approximate_camera_height", "lighting_use", "subject_fit", "scene_elements_used", "rationale", "feasibility", "warnings", "live_target_blueprint", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "candidate_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "disposition": {"const": "CANDIDATE"}, "selection_status": {"const": "NOT_SELECTED"}, "photo_concept": {"type": "string", "minLength": 1, "maxLength": 240},
    "view_ref": {"type": "string", "minLength": 1}, "framing": {"enum": ["ENVIRONMENTAL_FULL_BODY", "THREE_QUARTER_LIFESTYLE", "CLOSE_EMOTIONAL_PORTRAIT"]},
    "required_body_parts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["HEAD", "SHOULDERS", "TORSO", "ARMS", "HANDS", "LEGS", "FEET"]}},
    "image_plane_placement": {
      "type": "object", "additionalProperties": false, "required": ["composition_anchor_ref", "subject_anchor", "x", "y"],
      "properties": {"composition_anchor_ref": {"type": "string", "minLength": 1}, "subject_anchor": {"enum": ["EYES", "FACE_CENTER", "TORSO_CENTER", "BODY_CENTER"]}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "pose_plan": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1}},
    "camera_direction": {"type": "string", "minLength": 1, "maxLength": 240}, "approximate_camera_height": {"enum": ["EYE_LEVEL", "CHEST_LEVEL", "WAIST_LEVEL", "UNSPECIFIED"]},
    "lighting_use": {"type": "string", "minLength": 1, "maxLength": 320}, "subject_fit": {"type": "string", "minLength": 1, "maxLength": 320},
    "scene_elements_used": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
    "feasibility": {
      "type": "object", "additionalProperties": false, "required": ["status", "assessment_scope", "evidence_refs", "limitations"],
      "properties": {"status": {"enum": ["EXECUTABLE", "EXECUTABLE_WITH_WARNINGS", "NOT_EXECUTABLE"]}, "assessment_scope": {"const": "IMAGE_PLANE_AND_SEMANTIC"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "warnings": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "live_target_blueprint": {"$ref": "LiveTargetBlueprintV01.schema.json"},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["provider_mode", "request_id", "evidence_refs"],
      "properties": {"provider_mode": {"enum": ["FAKE", "REPLAY", "AI"]}, "request_id": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    }
  }
}
