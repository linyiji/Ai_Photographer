{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/SceneUnderstandingCandidateV01.schema.json","title":"SceneUnderstandingCandidateV01","description":"Non-authoritative photography-relevant scene understanding without physical affordance authority.","type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","disposition","observed","photography_inferences","confidence"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"candidate_id":{"type":"string","minLength":1,"maxLength":160},"disposition":{"const":"CANDIDATE"},"confidence":{"type":"number","minimum":0,"maximum":1},
    "observed":{"type":"object","additionalProperties":false,"required":["observation_ids","scene_category","usable_visual_elements","background_complexity","foreground_background_relationships","open_space_depth_cues","visual_distractions","view_interpretations","evidence_refs"],"properties":{
      "observation_ids":{"$ref":"#/$defs/nonEmptyStrings"},"scene_category":{"type":"string","minLength":1,"maxLength":120},"usable_visual_elements":{"$ref":"#/$defs/nonEmptyStrings"},"background_complexity":{"enum":["SIMPLE","MODERATE","COMPLEX"]},"foreground_background_relationships":{"$ref":"#/$defs/strings"},"open_space_depth_cues":{"$ref":"#/$defs/strings"},"visual_distractions":{"$ref":"#/$defs/strings"},"evidence_refs":{"$ref":"#/$defs/nonEmptyStrings"},
