  "$defs":{"strings":{"type":"array","items":{"type":"string","minLength":1}},"nonEmptyStrings":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"inference":{"type":"object","additionalProperties":false,"required":["inference_id","claim","based_on_observation_ids","confidence"],"properties":{"inference_id":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1,"maxLength":320},"based_on_observation_ids":{"$ref":"#/$defs/nonEmptyStrings"},"confidence":{"type":"number","minimum":0,"maximum":1}}}}
}
