{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/DomainEvent.schema.json","title":"DomainEvent","description":"Versioned business event carrying no credentials.","type":"object","additionalProperties":false,
  "required":["schema_version","event_id","event_type","event_version","session_id","occurred_at","producer","payload"],
  "properties":{"schema_version":{"const":"1.0.0"},"event_id":{"type":"string","minLength":1},"event_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},"event_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"session_id":{"type":"string","minLength":1},"occurred_at":{"type":"string","format":"date-time"},"producer":{"type":"object","additionalProperties":false,"required":["producer_id","producer_type"],"properties":{"producer_id":{"type":"string","minLength":1},"producer_type":{"enum":["USER","CLIENT","BACKEND","AI_CAPABILITY","SYSTEM"]}}},"payload":{"type":"object"},"causation_id":{"type":["string","null"]},"correlation_id":{"type":["string","null"]}}
}
