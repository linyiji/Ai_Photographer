{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/AssetManifest.schema.json","title":"AssetManifest","description":"Versioned registry of asset identity, integrity, storage and lineage.","type":"object","additionalProperties":false,
