{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xfx.local/contracts/v1/LiveTargetBlueprintV01.schema.json",
  "title": "LiveTargetBlueprintV01",
  "description": "Provider-neutral semantic and image-plane projection of a Director candidate; it contains no Live controller internals or physical authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "required_body_parts", "scale_target_concept", "primary_semantic_anchor", "anchor_x", "anchor_y", "tolerances", "secondary_constraints", "pose_constraints", "camera_constraints"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "required_body_parts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["HEAD", "SHOULDERS", "TORSO", "ARMS", "HANDS", "LEGS", "FEET"]}},
    "scale_target_concept": {"enum": ["ENVIRONMENTAL_FULL_BODY", "THREE_QUARTER_LIFESTYLE", "CLOSE_EMOTIONAL_PORTRAIT"]},
    "primary_semantic_anchor": {"enum": ["EYES", "FACE_CENTER", "TORSO_CENTER", "BODY_CENTER"]},
    "anchor_x": {"type": "number", "minimum": 0, "maximum": 1}, "anchor_y": {"type": "number", "minimum": 0, "maximum": 1},
    "tolerances": {
      "type": "object", "additionalProperties": false, "required": ["anchor_x", "anchor_y", "scale"],
      "properties": {"anchor_x": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25}, "anchor_y": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.35}}
    },
    "secondary_constraints": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["constraint_type", "instruction"],
        "properties": {"constraint_type": {"enum": ["HEADROOM", "BODY_VISIBILITY", "BACKGROUND_RELATIONSHIP", "HORIZON", "OCCLUSION"]}, "instruction": {"type": "string", "minLength": 1, "maxLength": 240}}
      }
    },
    "pose_constraints": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["body_area", "instruction"],
        "properties": {"body_area": {"enum": ["HEAD", "SHOULDERS", "TORSO", "ARMS", "HANDS", "LEGS", "FEET", "GAZE"]}, "instruction": {"type": "string", "minLength": 1, "maxLength": 240}}
      }
    },
    "camera_constraints": {
      "type": "object", "additionalProperties": false, "required": ["direction", "approximate_height", "metric_distance", "physical_standpoint", "physical_safety"],
      "properties": {
        "direction": {"type": "string", "minLength": 1, "maxLength": 240}, "approximate_height": {"enum": ["EYE_LEVEL", "CHEST_LEVEL", "WAIST_LEVEL", "UNSPECIFIED"]},
        "metric_distance": {"const": "UNSPECIFIED"}, "physical_standpoint": {"const": "NOT_ASSERTED"}, "physical_safety": {"const": "NOT_ASSESSED"}
      }
    }
  }
}
