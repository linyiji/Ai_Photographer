{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/CaptureAsset.schema.json","title":"CaptureAsset","description":"Persistent captured image lineage record using stable asset identity.","type":"object","additionalProperties":false,
