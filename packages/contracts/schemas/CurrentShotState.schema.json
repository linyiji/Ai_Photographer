  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/CurrentShotState.schema.json","title":"CurrentShotState","description":"Ephemeral semantic aggregation used for guidance and readiness, independent of a CV provider.","type":"object","additionalProperties":false,
