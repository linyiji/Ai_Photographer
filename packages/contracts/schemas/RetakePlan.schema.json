{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/RetakePlan.schema.json","title":"RetakePlan","description":"Persistent recovery plan that invalidates only failed dimensions and preserves valid state/assets.","type":"object","additionalProperties":false,
