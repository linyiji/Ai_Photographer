{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://xfx.local/contracts/v1/EvaluationResult.schema.json","title":"EvaluationResult","description":"Evidence-bearing evaluation whose warning result is distinct from task failure and gate disposition.","type":"object","additionalProperties":false,
  "required":["schema_version","evaluation_id","evaluated_subject","dimensions","overall_result","gate_disposition","created_at"],
  "properties":{"schema_version":{"const":"1.0.0"},"evaluation_id":{"type":"string","minLength":1},"evaluated_subject":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"enum":["CONTRACT","CANDIDATE","ASSET","SCENARIO","RUNTIME","TASK"]},"id":{"type":"string","minLength":1}}},"dimensions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","result","evidence_refs","warnings"],"properties":{"name":{"type":"string"},"result":{"enum":["PASS","PASS_WITH_WARNING","FAIL","SOURCE_REQUIRED","NOT_TESTED"]},"evidence_refs":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}}}}},"overall_result":{"enum":["PASS","PASS_WITH_WARNING","FAIL","SOURCE_REQUIRED","NOT_TESTED"]},"gate_disposition":{"enum":["PASS","BLOCKED","REVIEW_REQUIRED","FAIL"]},"created_at":{"type":"string","format":"date-time"}}
}
