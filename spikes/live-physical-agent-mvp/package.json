{
  "name": "@xfx/live-physical-agent-camera-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.18.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "prepare:mediapipe-assets": "node scripts/prepare-mediapipe-assets.mjs",
    "setup:model": "node scripts/fetch-pose-model.mjs",
    "predev": "npm run prepare:mediapipe-assets",
    "dev": "vite",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/perception.test.js .test-dist/tests/camera-session.test.js .test-dist/tests/closed-loop.test.js .test-dist/tests/visual-guidance.test.js .test-dist/tests/semantic-framing.test.js .test-dist/tests/control-v3.test.js .test-dist/tests/control-v4.test.js",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run prepare:mediapipe-assets",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  }
}
